# /etc/forge-table/<channel>.env for forge-table@<channel>.service (no secrets here). Every router flag can be set here
# as FT_<FLAG> (--max-matches: FT_MAX_MATCHES); the same file also works as `--config FILE` for a router started by hand.
# The address the reverse proxy connects to: 127.0.0.1 if the proxy runs on this host, else this host's own private
# address. Firewall FT_PORT so that only the proxy can reach it: whoever reaches this port can claim any user name.
FT_BIND=127.0.0.1
FT_PORT=8790
# 127.0.0.1 only: /healthz and /admin/drain for forge-table-deploy.sh (nothing else is served there).
FT_ADMIN_PORT=8799
# Hard cap on games: about (RAM - 2 GB) / 2 GB with -Xmx1536m (see the RUNBOOK's sizing). Unset: derived from RAM.
FT_MAX_MATCHES=4

# Multi-user: the authenticating reverse proxy's headers. Unset FT_TRUST_PROXY_HEADER = one local user, loopback only.
# The proxy MUST strip these headers from client requests and set them itself.
FT_TRUST_PROXY_HEADER=X-Forwarded-User
# Optional: the full-name header (its first word is the name others see); default: the login.
#FT_NAME_HEADER=X-Forwarded-Name
# The group-list header (needed by FT_REQUIRE_GROUP and FT_ADMIN_GROUP) and what joins the names
# (oauth2-proxy: X-Forwarded-Groups and ","; Authentik: X-authentik-groups and "|").
#FT_GROUPS_HEADER=X-Forwarded-Groups
#FT_GROUPS_SEPARATOR=,
# Only members of this group may play (empty: every signed-in user).
#FT_REQUIRE_GROUP=
# Members of this group are admins (the lobby's Admin section: every game, End, Update now). Empty = no admins.
# Set it only once the proxy is verified to strip a client's own groups header: otherwise a forged header is admin.
FT_ADMIN_GROUP=
# Absolute links (link previews, invites) for a request without a usable Host header, e.g. https://table.example.org
#FT_PUBLIC_URL=
# Guest invites (no login) under /g/: needs the proxy's client-address header for the join limit, and the proxy must
# let /g/* through without its login.
#FT_GUESTS=true
#FT_REAL_IP_HEADER=X-Real-IP
# The Framed card face's own fonts, if you have them: a folder with beleren.ttf or .woff2 (titles) and mplantin.woff
# or .woff2 (rules text). Unset: the open Faustina and Splentinex in the bundle.
#FT_FONTS=/etc/forge-table/fonts

# Send finished games to an AI learner (the lobby's "Send my games to train the AI" toggle; needs the neural plugin):
#   on    = sent by default; a user may turn it off.
#   optin = not sent by default; a user may turn it on.
#   off   = never, whatever a user picks; the toggle doesn't even show.
# Each game ships the player's OWN play (casts, lands, abilities, keep/mulligan, attacks/blocks and other decisions), the
# AI's side and the result (no names or other personal data) to FT_MTGAI_UPLOAD_URL.
# Empty FT_MTGAI_UPLOAD_URL also means never, regardless of FT_MTGAI_UPLOAD.
FT_MTGAI_UPLOAD=off
FT_MTGAI_UPLOAD_URL=

# Optional operator-only text game logs. Includes player names and hidden cards: restrict directory access and
# notify players. Independent of training consent; never uploaded. Unset: disabled. Put beside, not in, traj/.
#FT_GAME_LOG_DIR=/var/lib/forge-table/neural-games/logs
# At most this many files, including games still playing; at most this many UTF-8 bytes per file.
#FT_GAME_LOG_KEEP=200
#FT_GAME_LOG_MAX_BYTES=4194304

# What the UI calls the neural AI plugin's opponent (environment only: the games read it, not just the router).
#FT_NEURAL_LABEL=Neural
# Its picture in place of its initial at the table and in the lobby: a PNG, WebP or JPEG file of at most 1 MB. Unset:
# avatar.png or avatar.webp in the model folder (-Dmtgai.neural.dir), if there is one, else the art crop of a card (below),
# fetched like all card art (none with --card-art off). Read again when the file changes.
#FT_NEURAL_AVATAR=
# That card: "Name" or "Name|SET". Unset: "avatar_card" in the model's latest.json. Set it where a model updater
# rewrites latest.json without that field.
#FT_NEURAL_AVATAR_CARD=Lyra Dawnbringer|DOM
